APP_NAME=Vertrag Home
APP_ENV=production
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_DATABASE=vertrag_home
DB_USERNAME=vertrag_home
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

SESSION_NAME=vertrag_home_session
SESSION_SECURE_COOKIE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Optional: comma-separated proxy IPs/CIDRs that may supply X-Forwarded-For
TRUSTED_PROXIES=
